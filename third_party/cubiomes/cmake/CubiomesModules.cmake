include_guard(GLOBAL)

function(_cubiomes_module root prefix revision module)
    set(target "${prefix}_${module}")
    if(TARGET "${target}")
        get_target_property(existing_root "${target}" CUBIOMES_SOURCE_ROOT)
        if(NOT "${existing_root}" STREQUAL "${root}")
            message(FATAL_ERROR "${prefix}已用于另一份Cubiomes；独立依赖请使用不同PREFIX")
        endif()
        return()
    endif()
    file(READ "${root}/cmake/modules.json" specification)
    string(JSON description ERROR_VARIABLE error GET "${specification}" "${module}")
    if(error)
        message(FATAL_ERROR "未知Cubiomes模块：${module}")
    endif()
    set(dependencies)
    string(JSON count LENGTH "${description}" dependencies)
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE ${last})
            string(JSON dependency GET "${description}" dependencies ${index})
            _cubiomes_module("${root}" "${prefix}" "${revision}" "${dependency}")
            list(APPEND dependencies "${prefix}::${dependency}")
        endforeach()
    endif()
    set(sources)
    string(JSON count LENGTH "${description}" sources)
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE ${last})
            string(JSON source GET "${description}" sources ${index})
            list(APPEND sources "${root}/${source}")
        endforeach()
    endif()
    if(sources)
        add_library("${target}" STATIC ${sources})
        set(usage PUBLIC)
        # 保留Java回绕与浮点顺序；分节后由最终链接裁掉未使用的函数和常量。
        target_compile_options("${target}" PRIVATE
            -O3 -fwrapv -ffp-contract=off -ffunction-sections -fdata-sections)
        target_compile_features("${target}" PUBLIC c_std_11)
        target_link_libraries("${target}" PUBLIC m)
    else()
        add_library("${target}" INTERFACE)
        set(usage INTERFACE)
        target_compile_options("${target}" INTERFACE -ffp-contract=off)
    endif()
    add_library("${prefix}::${module}" ALIAS "${target}")
    set_property(TARGET "${target}" PROPERTY CUBIOMES_SOURCE_ROOT "${root}")
    target_include_directories("${target}" ${usage} "${root}" "${root}/..")
    target_link_libraries("${target}" ${usage} ${dependencies})
    if(APPLE)
        target_link_options("${target}" INTERFACE "LINKER:-dead_strip")
    else()
        target_link_options("${target}" INTERFACE "LINKER:--gc-sections")
    endif()
    if(revision)
        string(SUBSTRING "${revision}" 0 16 short_revision)
        target_compile_definitions("${target}" ${usage}
            CUBIOMES_REVISION="${revision}" CUBIOMES_FINGERPRINT=0x${short_revision}ULL)
    endif()
endfunction()

function(cubiomes_add_modules)
    cmake_parse_arguments(ARG "" "ROOT;PREFIX;LOCK" "MODULES" ${ARGN})
    if(NOT ARG_ROOT OR NOT ARG_MODULES OR ARG_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "cubiomes_add_modules需要ROOT和MODULES，可选PREFIX、LOCK")
    endif()
    if(MSVC)
        message(FATAL_ERROR "该Cubiomes模块使用GCC/Clang数值语义；Windows请使用MinGW")
    endif()
    get_filename_component(root "${ARG_ROOT}" ABSOLUTE)
    if(NOT ARG_PREFIX)
        set(ARG_PREFIX Cubiomes)
    endif()
    set(revision)
    if(NOT ARG_LOCK AND EXISTS "${root}/../cubiomes-lock.json")
        set(ARG_LOCK "${root}/../cubiomes-lock.json")
    endif()
    if(ARG_LOCK)
        get_filename_component(lock "${ARG_LOCK}" ABSOLUTE)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${lock}")
        file(READ "${lock}" manifest)
        string(JSON revision GET "${manifest}" commit)
        string(JSON modules GET "${manifest}" modules)
        string(JSON count LENGTH "${modules}")
        set(available)
        if(count GREATER 0)
            math(EXPR last "${count} - 1")
            foreach(index RANGE ${last})
                string(JSON name GET "${modules}" ${index})
                list(APPEND available "${name}")
            endforeach()
        endif()
        foreach(module IN LISTS ARG_MODULES)
            if(NOT module IN_LIST available)
                message(FATAL_ERROR "依赖包未声明${module}，请从维护仓库重新导出所需模块")
            endif()
        endforeach()
    endif()
    foreach(module IN LISTS ARG_MODULES)
        _cubiomes_module("${root}" "${ARG_PREFIX}" "${revision}" "${module}")
    endforeach()
endfunction()
