      "file": "tables/btree263.h",
      "purpose": "依照原版26.3的19分支树重导出，修复同距群系边界的选择差异",
      "scope": "仅MC_26_3群系树；原版样本与结构起点冻结在tests/java263-reference.tsv"
    },
    {
      "file": "biomenoise.c",
      "purpose": "保留空缓存修复，并按26.3切换原版float气候、样条与深度顺序",
      "scope": "旧版本数值路径保留；新增通用原始气候、分量噪声及深度接口"
    },
    {
      "file": "noise.c",
      "purpose": "保留纵向量化epsilon，并提供原版26.3的float Perlin和交错噪声栈",
      "scope": "旧samplePerlin/sampleDoublePerlin不改为float；新版接口独立"
    },
    {
      "file": "CMakeLists.txt",
      "purpose": "独立构建固定-fwrapv与-ffp-contract=off，保留数值语义",
      "scope": "维护库独立构建；各搜索器保留自身等价编译选项"
    },
    {
      "file": "extensions/java263_noise.hpp",
      "purpose": "保留原GPL C++接口，Perlin计算统一转调MIT核心",
      "scope": "可选C++扩展，显式调用；旧版double路径和未接入的群系采样不变",
      "license": "GPL-3.0-only"
    },
    {
      "file": "cmake/CubiomesModules.cmake",
      "purpose": "按能力提供静态模块与固定数值编译选项，导出和构建共用模块声明",
      "scope": "显式模块构建；旧上游全库入口保留"
    },
    {
      "file": "tables/spline263.h",
      "purpose": "原版26.3群系深度样条系数，避免旧公式重建的舍入差异",
      "scope": "仅26.3群系气候；不含产品密度图"
    },
    {
      "file": "finders.c",
      "purpose": "按原版区块内(9,9)检查神殿周围群系，修复边缘误拒绝",
      "scope": "1.18及之后的神殿准入"
    }
  ],
